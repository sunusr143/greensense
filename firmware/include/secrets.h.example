// Copy to secrets.h (git-ignored) and fill in. Never commit real values.
// Device identity comes from the certificate AWS IoT issued for THIS board.
#pragma once

#define WIFI_SSID "your-wifi"
#define WIFI_PASSWORD "your-password"
#define AWS_IOT_ENDPOINT "xxxxxxxx-ats.iot.eu-west-1.amazonaws.com"
#define DEVICE_ID "gs-001"  // must equal the IoT thing name

static const char AWS_ROOT_CA[] = R"EOF(
-----BEGIN CERTIFICATE-----
(Amazon Root CA 1)
-----END CERTIFICATE-----
)EOF";

static const char DEVICE_CERT[] = R"EOF(
-----BEGIN CERTIFICATE-----
(device certificate)
-----END CERTIFICATE-----
)EOF";

static const char DEVICE_KEY[] = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
(device private key)
-----END RSA PRIVATE KEY-----
)EOF";
